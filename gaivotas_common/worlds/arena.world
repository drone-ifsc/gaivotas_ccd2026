<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="arena">
    
    
    <!-- Adiciona o chão -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Luz ambiente -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Base de Pouso -->
    <model name="base1">
      <include> 
        <uri>model://base_pouso</uri>
        <pose>0 0 0 0 0 0</pose>
      </include> 
    </model>

    <!-- Base de Pouso -->
    <model name="base2">
      <include> 
        <uri>model://base_pouso</uri>
        <pose>8 2 0 0 0 0</pose>
      </include> 
    </model>


    <!-- Iris UAV -->
    <model name="droneIFSC">
      <include>
        <uri>model://droneIFSC</uri>  
      </include>
      <pose>0 0 0 0 0 1.5708</pose>  
    </model>

  </world>
</sdf>

 