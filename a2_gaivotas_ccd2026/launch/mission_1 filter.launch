<launch>
        <include file="$(find gaivotas_common)/launch/apm.launch">
        </include>
    <node pkg="mavros" type="mavsys" name="mavsys_rate_all"
    args="rate --all 20" output="screen" />


    <node pkg="bouncing_mission" type="rangefinder_filter.py" name="rangefinder_filter" output="screen" respawn="true">
        <param name="input_topic" value="/mavros/distance_sensor/rangefinder_pub"/>
        <param name="output_topic" value="/mavros/distance_sensor/rangefinder_sub"/>
        <param name="debug_topic" value="/rangefinder/filtered"/>
        <param name="min_range" value="0.15"/>
        <param name="max_range" value="6.95"/>
    </node>
 <!--   <node pkg="bouncing_mission" type="visionnode.py" name="visionnode" required="true" />     -->
</launch>
