      <visual name="visual_front">
        <pose>0.0501 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.001 0.842 0.842</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_qr_symbol/materials/scripts</uri>
